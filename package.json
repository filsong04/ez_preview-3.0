{
  "name": "ez-preview-desktop",
  "version": "1.0.0-rc.8",
  "description": "Fast local video and LUT preview for macOS and Windows",
  "private": true,
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test:native": "node scripts/run-native-smoke-tests.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "dist": "electron-builder",
    "dist:mac:intel": "electron-builder --mac dmg zip --x64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:win:arm64": "electron-builder --win nsis --arm64",
    "dist:linux": "electron-builder --linux AppImage",
    "release:checksums": "node scripts/write-checksums.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.ezpreview.desktop",
    "productName": "EZ Preview",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!scripts/**",
      "!.github/**",
      "!build/**",
      "!release/**",
      "!.release-lock/**",
      "!dependency-sbom.spdx.json",
      "!*.command",
      "!*.bat",
      "!README.md",
      "!BUILD-RELEASE.md",
      "!RELEASE-BLOCKERS.md",
      "!package-lock.json",
      "!*.zip",
      "!REPAIR-NOTES.md",
      "!PUBLISH-RC3.md",
      "!CHANGELOG-RC4.md"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.video",
      "minimumSystemVersion": "12.0.0",
      "artifactName": "EZ-Preview-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "binaries": [
        "Contents/Resources/app.asar.unpacked/node_modules/ffmpeg-static/ffmpeg"
      ],
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "EZ Preview ${version}",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "EZ-Preview-${version}-${arch}.${ext}",
      "legalTrademarks": "EZ Preview"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "EZ-Preview-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "EZ-Preview-${version}-${arch}-Portable.${ext}"
    },
    "nsis": {
      "artifactName": "EZ-Preview-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=24"
  }
}
